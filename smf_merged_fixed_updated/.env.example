# =============================================================
# .env.example - SMF Smart Attendance System
# Copy this file to .env and fill in your actual production values.
# NEVER commit the real .env file with secrets to Git.
# =============================================================

# ── SMTP Mailer Configuration ────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-service-account@college.edu
SMTP_PASS=your-secure-app-password

# ── Administrator & Role Accounts ─────────────────────────────
ADMIN_EMAIL=admin@college.edu
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SetAStrongPasswordHere123!
HOD_EMAIL=hod@college.edu
FACULTY_DEFAULT_EMAIL=faculty@college.edu

# ── Cryptographic Secrets ─────────────────────────────────────
# Minimum 32-character high-entropy secret for JWT and OTP HMAC.
# If left blank, SMF will auto-generate a secure 256-bit token on first run.
API_SECRET_KEY=

# ── Database Storage ──────────────────────────────────────────
# Defaults to data/attendance.db (isolated outside web root)
DB_PATH=data/attendance.db

# ── CORS Lockdown ─────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://127.0.0.1:8000
