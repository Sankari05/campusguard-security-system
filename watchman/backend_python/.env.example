# Environment variable template - copy this to .env and fill values
# DO NOT commit .env to git - only commit this .env.example file

DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/campusguard_db

JWT_SECRET=YOUR_SECURE_JWT_SECRET_HERE
JWT_EXPIRATION_HOURS=24

APP_ENV=development
APP_PORT=8080
APP_DEBUG=true
