# ==============================================================================
# RidgeWatch Notification & SMSGate Configuration Example
# ==============================================================================

# SMS Channel Provider (SMSGate Local Server via Android Physical SIM)
SMS_PROVIDER=SMSGATE

# SMSGate Local Server Configuration (Android Phone Physical SIM Gateway)
# SMSGate Android app v1.75.0 running Local Server with HTTP Basic Auth
# Local API Endpoint: POST http://<device_local_ip>:8080/message
# Note: SMSGate Local Server is only reachable on the same local Wi-Fi/network as the Android phone.
SMSGATE_ENABLED=true
SMSGATE_LOCAL_URL=http://<device_local_ip>:8080
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_SIM_NUMBER=1

# ==============================================================================
# Non-Contact Flood-Water Level & Hydrostatic Pressure Monitoring Configuration
# ==============================================================================
NONCONTACT_SENSOR_TYPE=ultrasonic
NONCONTACT_SENSOR_MOUNT_HEIGHT_M=5.0
NONCONTACT_PRESSURE_DATUM_M=0.0
NONCONTACT_SENSOR_MAX_RANGE_M=10.0
NONCONTACT_SENSOR_TIMEOUT_SECONDS=30
NONCONTACT_WATER_DENSITY_KG_M3=1000
NONCONTACT_GRAVITY_M_S2=9.80665
NONCONTACT_MAX_RISE_RATE_M_PER_SECOND=0.5

# ==============================================================================
# RidgeWatch Resilient Offline Emergency Communication Configuration
# ==============================================================================
OFFLINE_COMMUNICATION_ENABLED=true
OFFLINE_DB_PATH=backend/data/offline_messages.db
LORA_MODE=simulator
LORA_DEVICE_ID=RIDGEWATCH-GATEWAY-01
LORA_FREQUENCY_MHZ=868.0
LORA_TX_POWER_DBM=14.0
LORA_MAX_RANGE_METERS=5000.0
LORA_MAX_HOPS=5
LORA_SERIAL_PORT=COM3
LORA_BAUD_RATE=115200
OFFLINE_SYNC_INTERVAL_SECONDS=15
OFFLINE_MESSAGE_TTL_SECONDS=86400
OFFLINE_RETRY_LIMIT=5
